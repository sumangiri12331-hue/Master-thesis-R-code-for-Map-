library(sf)
library(ggplot2)
library(scales)
library(ggrepel)

map_data <- sf::st_transform(map_data, 4326)

countries <- levels(map_data$highlight)
countries <- countries[countries != "Other"]

country_colors <- hue_pal(l = 60, c = 110)(length(countries))
names(country_colors) <- countries
country_colors <- c(country_colors, Other = "#E6E6E6")

centroids <- st_centroid(map_data)
coords <- st_coordinates(centroids)

label_df <- data.frame(
  x = coords[,1],
  y = coords[,2],
  country = map_data$highlight
)

label_df <- label_df[label_df$country != "Other", ]

p <- ggplot(map_data) +
  
  geom_sf(
    aes(fill = highlight),
    color = "grey25",
    linewidth = 0.6
  ) +
  
  scale_fill_manual(values = country_colors) +
  
  geom_label_repel(
    data = label_df,
    aes(x = x, y = y, label = country),
    
    size = 3.2,
    nudge_x = 8,
    nudge_y = 4,
    
    color = "black",
    fontface = "bold",
    fill = "white",
    label.size = 0.3,
    
    box.padding = 0.9,
    point.padding = 0.7,
    
    min.segment.length = 0,
    segment.color = "red",
    segment.size = 0.8,
    
    force = 5,
    max.overlaps = Inf
  ) +
  
  coord_sf(expand = FALSE) +
  
  theme_minimal(base_size = 16) +
  theme(
    panel.grid = element_blank(),
    panel.background = element_rect(fill = "white"),
    plot.background = element_rect(fill = "white"),
    
    legend.position = "bottom",
    legend.box = "horizontal",
    
    legend.text = element_text(size = 7),   # 🔥 smaller legend text
    legend.title = element_text(size = 10), # optional
    
    aspect.ratio = 0.6,
    plot.title = element_text(size = 18, face = "bold")
  ) +
  
  labs(
    title = "Countries of Respondents",
    fill = "Countries"
  )

p

ggsave(
  filename = "countries_map.jpeg",
  plot = p,
  width = 16,
  height = 9,
  units = "in",
  dpi = 600,
  bg = "white"
)
